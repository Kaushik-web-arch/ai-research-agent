# Use a free Google AI Studio API key.
# Either variable name works; keep only one real key in your private .env file.
GOOGLE_API_KEY=

# Free-tier model used for planning and report writing.
GEMINI_MODEL=gemini-3.5-flash-lite

# Keep these values small to stay friendly to free-tier limits.
HOW_MANY_SEARCHES=3
REPORT_WORD_TARGET=1000

# Repeated identical research can be served locally without another API call.
CACHE_HOURS=24
